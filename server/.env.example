PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-64-char-random-hex-string

# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# Must be >= 16 characters in production. NEVER use '1234' or 'admin123'.
ADMIN_SIGNUP_CODE=replace-with-strong-random-code

FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Required in production for password-reset email delivery.
RESEND_API_KEY=re_xxxxxxxxx
PASSWORD_RESET_EMAIL_FROM=CampusClash <no-reply@yourdomain.edu>

# Set TRUST_PROXY=true when deployed behind one reverse proxy (e.g. Render, Railway)
# so rate limits use the real visitor IP rather than the proxy IP.
TRUST_PROXY=false
